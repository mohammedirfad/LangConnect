NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://landconnect:local_dev_only@localhost:5433/landconnect?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
