NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://landconnect:local_dev_only@127.0.0.1:5434/landconnect?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
TRUST_PROXY=false
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
