{
  "expo": {
    "name": "LandConnect",
    "slug": "landconnect",
    "scheme": "landconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose listing photos to upload."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show nearby land listings and select a listing location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.landconnect.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.landconnect.app",
      "infoPlist": {
        "NSCameraUsageDescription": "LandConnect uses your camera during video calls.",
        "NSMicrophoneUsageDescription": "LandConnect uses your microphone during audio and video calls."
      },
      "bitcode": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "61e7d64e-7eb0-4468-b1c8-0f73930f11aa"
      }
    }
  }
}
